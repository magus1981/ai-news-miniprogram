.tag-page {
  min-height: 100vh;
  background: #f5f6fa;
}

/* 标签头部 */
.tag-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 40rpx 32rpx;
}

.tag-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.tag-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 文章列表 */
.article-list {
  padding: 24rpx;
}

.loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #a0aec0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #a0aec0;
}
