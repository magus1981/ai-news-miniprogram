<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="detail-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 错误 -->
  <view wx:elif="{{error}}" class="empty-state">
    <text class="empty-icon">⚠️</text>
    <text class="empty-text">{{error}}</text>
  </view>

  <!-- 文章内容 -->
  <block wx:elif="{{article}}">
    <view class="article-header">
      <view class="article-title">{{article.title}}</view>
      <view class="article-info">
        <text class="info-source">{{article.source_name}}</text>
        <text class="info-dot">·</text>
        <text class="info-time">{{fmt.formatTime(article.published_at)}}</text>
        <text class="info-tag tag tag-{{article.category}}">{{fmt.categoryLabel(article.category)}}</text>
      </view>
      <view wx:if="{{article.original_title}}" class="original-title">
        原标题：{{article.original_title}}
      </view>

      <!-- 一句话要点：扫一眼就知道这条新闻是什么 -->
      <view wx:if="{{article.takeaway}}" class="takeaway-box">{{article.takeaway}}</view>

      <!-- 子标签组：公司+人物+区域，全部可点击跳标签页 -->
      <view
        wx:if="{{article.tags && ((article.tags.companies && article.tags.companies.length > 0) || (article.tags.people && article.tags.people.length > 0) || (article.tags.regions && article.tags.regions.length > 0))}}"
        class="detail-subtags"
      >
        <text
          wx:for="{{article.tags.companies}}"
          wx:key="*this"
          class="subtag-chip"
          data-tag="{{item}}"
          data-type="company"
          catchtap="onTagTap"
        >{{item}}</text>
        <text
          wx:for="{{article.tags.people}}"
          wx:key="*this"
          class="subtag-chip subtag-chip-people"
          data-tag="{{item}}"
          data-type="people"
          catchtap="onTagTap"
        >{{item}}</text>
        <text
          wx:for="{{article.tags.regions}}"
          wx:key="*this"
          class="subtag-chip subtag-chip-region"
          data-tag="{{item}}"
          data-type="regions"
          catchtap="onTagTap"
        >{{item}}</text>
      </view>
    </view>

    <!-- 核心要点（历史文章有key_points数据时显示，放在摘要之前） -->
    <view wx:if="{{article.key_points && article.key_points.length > 0}}" class="keypoints-section">
      <view class="keypoints-label">核心要点</view>
      <view wx:for="{{article.key_points}}" wx:key="*this" class="keypoint-item">
        <text class="keypoint-dot">•</text>
        <text class="keypoint-text">{{item}}</text>
      </view>
    </view>

    <!-- AI精华总结 -->
    <view class="summary-section">
      <view class="summary-label">AI 精华总结</view>
      <view class="summary-content">{{article.summary || '暂无总结'}}</view>
    </view>

    <!-- 原文金句（程序校验逐字来自原文，无则不显示） -->
    <view wx:if="{{article.quote}}" class="quote-section">
      <view class="quote-text">“{{article.quote}}”</view>
      <view class="quote-src">—— 摘自原文</view>
    </view>

    <!-- 此前相关报道（后端分层判定，不够相关时返回空、整块不展示） -->
    <view wx:if="{{article.related && article.related.length > 0}}" class="related-section">
      <view class="related-label">此前相关报道</view>
      <view
        wx:for="{{article.related}}"
        wx:key="id"
        class="related-item"
        data-id="{{item.id}}"
        bindtap="onRelatedTap"
      >
        <text class="related-title">{{item.title}}</text>
        <text class="related-meta">{{item.relationLabel}} · {{item.date_key}} · {{item.source_name}}</text>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="action-bar">
      <button class="action-btn action-original" bindtap="openOriginal">
        阅读原文
      </button>
      <button
        class="action-btn {{isFavorited ? 'action-favorited' : 'action-favorite'}}"
        bindtap="toggleFavorite"
      >
        {{isFavorited ? '已收藏' : '收藏'}}
      </button>
      <button class="action-btn action-share" open-type="share">
        分享
      </button>
    </view>
  </block>
</view>
