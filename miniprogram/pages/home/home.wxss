.home-page {
  min-height: 100vh;
}

/* 今日必读区域 */
.featured-section {
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding: 32rpx 24rpx 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.featured-scroll {
  white-space: nowrap;
}

.featured-list {
  display: inline-flex;
  gap: 20rpx;
}

.featured-list featured-card {
  display: inline-block;
  width: 560rpx;
}

/* 分类Tab */
.category-tabs {
  background: #ffffff;
  border-bottom: 1rpx solid #e2e8f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs-inner {
  display: inline-flex;
  padding: 20rpx 24rpx;
  gap: 12rpx;
}

.tab-item {
  display: inline-block;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  color: #718096;
  background: #f7fafc;
  transition: all 0.2s;
}

.tab-active {
  color: #ffffff;
  background: #1a1a2e;
  font-weight: 500;
}

/* 文章列表 */
.article-list {
  padding: 24rpx;
}
