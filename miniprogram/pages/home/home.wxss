.home-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  position: relative;
}

/* ===== 极光背景光斑 ===== */
.aurora-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  opacity: 0.55;
}

.blob-1 {
  width: 520rpx;
  height: 520rpx;
  top: -140rpx;
  left: -120rpx;
  background: radial-gradient(circle, #c7d2fe 0%, rgba(199, 210, 254, 0) 70%);
}

.blob-2 {
  width: 460rpx;
  height: 460rpx;
  top: 220rpx;
  right: -160rpx;
  background: radial-gradient(circle, #a5f3fc 0%, rgba(165, 243, 252, 0) 70%);
}

.blob-3 {
  width: 560rpx;
  height: 560rpx;
  top: 55%;
  left: -180rpx;
  background: radial-gradient(circle, #fbcfe8 0%, rgba(251, 207, 232, 0) 70%);
}

/* 内容层级高于背景 */
.brief-header,
.hero-card,
.mid-card,
.rest-section,
.catchup-section,
.archive-section,
.skeleton-group,
.empty-state {
  position: relative;
  z-index: 1;
}

/* ===== 简报头 ===== */
/* 品牌头：logo + 名称 + slogan */
.brand-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 8rpx 20rpx;
}
.brand-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.25);
}
.brand-text {
  display: flex;
  flex-direction: column;
}
.brand-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1e1b4b;
  letter-spacing: 2rpx;
}
.brand-slogan {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 2rpx;
}

.brief-header {
  padding: 16rpx 8rpx 28rpx;
}

/* 日期行：左右箭头 + 可点日期标签 */
.brief-date-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.brief-date {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

.brief-date-tappable {
  padding: 8rpx 12rpx;
  margin: -8rpx 0;
  border-radius: 12rpx;
}

.brief-date-tappable:active {
  background: rgba(99, 102, 241, 0.08);
}

.date-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-text-secondary);
  border-radius: 50%;
}

.date-arrow:active {
  background: rgba(99, 102, 241, 0.1);
}

.date-arrow-hidden {
  visibility: hidden;
}

.brief-title {
  font-size: 48rpx;
  font-weight: 800;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: inline-block;
}

.brief-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ===== 今日导语 ===== */
.intro-card {
  position: relative;
  z-index: 1;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.intro-label {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: inline-block;
  margin-bottom: 10rpx;
}

.intro-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* ===== 头条大卡 ===== */
.hero-card {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.hero-rank {
  font-size: 40rpx;
  font-weight: 800;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-top .score-badge {
  margin-left: auto;
}

/* 新增角标：本轮采集刚入库，绿底白字，与红色突发/精选区分 */
.new-badge {
  font-size: 20rpx;
  color: #fff;
  background: #10b981;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
  margin-bottom: 14rpx;
}

.hero-summary {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meta-source {
  font-size: 22rpx;
  color: var(--color-accent);
  font-weight: 500;
}

.meta-time {
  font-size: 22rpx;
  color: #b0b6c3;
}

/* ===== 精选中卡 ===== */
.mid-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx;
  margin-bottom: 16rpx;
}

.mid-rank {
  font-size: 32rpx;
  font-weight: 800;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  color: #c7cbf5;
  flex-shrink: 0;
}

.mid-body {
  flex: 1;
  min-width: 0;
}

.mid-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.mid-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mid-card .score-badge {
  flex-shrink: 0;
}

/* ===== 今日更多 ===== */
.rest-section {
  margin-top: 36rpx;
}

.rest-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 8rpx 16rpx;
}

.rest-title {
  font-size: 34rpx;
  font-weight: 700;
}

.rest-count {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ===== 补读区（漏读回捞）与往期重要区 =====
   两块共用 .section-hint / .section-more：它们在结构上是同一类东西——
   接在当日日报之后的补充区，视觉上必须一致才不会显得零碎 */
.catchup-section {
  margin-top: 44rpx;
  /* 与今日日报之间划一道明确的界，否则容易被误读成"今天还有这些" */
  border-top: 2rpx solid rgba(99, 102, 241, 0.16);
  padding-top: 28rpx;
}

.archive-section {
  margin-top: 44rpx;
  border-top: 2rpx solid rgba(99, 102, 241, 0.16);
  padding-top: 28rpx;
}

.section-hint {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding: 0 8rpx 20rpx;
}

.catchup-day {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  padding: 18rpx 8rpx 10rpx;
}

.section-more {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
  padding: 28rpx 8rpx 8rpx;
}

/* 可点的展开态：主题色 + 稍大字号，与纯提示态区分开 */
.section-more-tap {
  color: var(--color-accent);
  font-size: 24rpx;
  font-weight: 500;
}

/* 吸顶轻筛选条 */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  margin: 0 -24rpx;
  padding: 12rpx 24rpx;
  background: rgba(244, 245, 251, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.filter-scroll {
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  gap: 14rpx;
}

.filter-chip {
  display: inline-block;
  font-size: 25rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  transition: all 0.2s;
  flex-shrink: 0;
}

.filter-active {
  color: #ffffff;
  background: var(--gradient-accent);
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(139, 92, 246, 0.3);
}

/* 热门子标签横滑条 */
.hot-tags-row {
  padding: 12rpx 0 4rpx;
}

.hot-tags-scroll {
  white-space: nowrap;
}

.hot-tags-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 8rpx;
}

.hot-tag-chip {
  display: inline-block;
  font-size: 24rpx;
  color: var(--color-accent);
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid #dfe3fc;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* "全部/收起"展开钮：与chip同形，加深底色以示操作 */
.hot-tag-more {
  color: #6b7280;
  background: #f1f3f9;
  border-color: #d7dbee;
}

/* 全部标签面板：白名单全量名单，流式排布，每项带文章数 */
.all-tags-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 16rpx 8rpx 8rpx;
}

.all-tag-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-accent);
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid #dfe3fc;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.all-tag-count {
  font-size: 20rpx;
  color: #9ca3af;
}

/* 文章列表 */
.article-list {
  padding-top: 16rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-group {
  padding-top: 8rpx;
}

.skeleton {
  position: relative;
  overflow: hidden;
}

.skeleton::after {
  content: '';
  position: absolute;
  top: 0;
  left: -60%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
  animation: shimmer 1.2s infinite;
}

@keyframes shimmer {
  100% { left: 120%; }
}

.skeleton-hero {
  height: 320rpx;
}

.skeleton-row {
  height: 140rpx;
}

/* ===== 往期日报半屏面板 ===== */
.date-panel-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(31, 36, 55, 0.45);
  display: flex;
  align-items: flex-end;
}

.date-panel {
  width: 100%;
  max-height: 65vh;
  display: flex;
  flex-direction: column;
  border-radius: 32rpx 32rpx 0 0;
  margin-bottom: 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
}

.date-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.date-panel-title {
  font-size: 32rpx;
  font-weight: 700;
}

.date-panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  border-radius: 50%;
  background: #f1f3f9;
}

.date-panel-list {
  flex: 1;
  min-height: 0;
  max-height: 52vh;
}

.date-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 12rpx;
  border-bottom: 1rpx solid rgba(99, 102, 241, 0.08);
}

.date-item:active {
  background: rgba(99, 102, 241, 0.06);
}

.date-item-active .date-item-label {
  color: var(--color-accent);
  font-weight: 700;
}

.date-item-label {
  font-size: 28rpx;
}

.date-item-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
