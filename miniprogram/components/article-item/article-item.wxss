.article-item {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.article-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #2d3748;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.article-source {
  font-size: 22rpx;
  color: #a0aec0;
}

.article-time {
  font-size: 22rpx;
  color: #cbd5e0;
}

.article-tag {
  font-size: 20rpx;
}

.article-hot {
  font-size: 20rpx;
  color: #e53e3e;
  background: #fff5f5;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

/* 子标签chip：浅色描边，区别于分类标签 */
.subtag-chip {
  font-size: 20rpx;
  color: #4a6cf7;
  background: #f7faff;
  border: 1rpx solid #c7d7fe;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}
