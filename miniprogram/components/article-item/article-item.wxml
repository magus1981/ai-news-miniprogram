<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="article-item {{article.is_breaking ? 'article-item-breaking' : ''}}" bindtap="onTap">
  <view class="article-head">
    <view class="article-title">{{article.title}}</view>
    <text wx:if="{{article.ai_score}}" class="score-badge {{fmt.scoreBandClass(article.ai_score)}}">{{fmt.scoreBand(article.ai_score)}}</text>
  </view>
  <view class="article-meta">
    <text class="article-source">{{article.source_name}}</text>
    <text class="article-time">{{fmt.relativeTime(article.published_at)}}</text>
    <text class="article-tag tag tag-{{article.category}}">{{fmt.categoryLabel(article.category)}}</text>
    <!-- 子标签chip：公司类显示公司名，观点类显示人物名，catchtap阻止卡片跳转 -->
    <text
      wx:if="{{article.category === 'company' && article.tags && article.tags.companies && article.tags.companies.length > 0}}"
      class="subtag-chip"
      data-tag="{{article.tags.companies[0]}}"
      data-type="company"
      catchtap="onSubtagTap"
    >{{article.tags.companies[0]}}</text>
    <text
      wx:elif="{{article.category === 'opinion' && article.tags && article.tags.people && article.tags.people.length > 0}}"
      class="subtag-chip"
      data-tag="{{article.tags.people[0]}}"
      data-type="people"
      catchtap="onSubtagTap"
    >{{article.tags.people[0]}}</text>
    <text
      wx:elif="{{article.category === 'policy' && article.tags && article.tags.regions && article.tags.regions.length > 0}}"
      class="subtag-chip subtag-chip-region"
      data-tag="{{article.tags.regions[0]}}"
      data-type="regions"
      catchtap="onSubtagTap"
    >{{article.tags.regions[0]}}</text>
    <text wx:if="{{article.is_new}}" class="article-new">新</text>
    <text wx:if="{{article.is_breaking}}" class="article-breaking">突发</text>
    <text wx:if="{{article.is_featured}}" class="article-hot">精选</text>
  </view>
</view>
