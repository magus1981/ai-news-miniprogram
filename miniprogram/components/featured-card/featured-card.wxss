.featured-card {
  position: relative;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.featured-card::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(74, 108, 247, 0.15);
  border-radius: 50%;
}

.featured-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: var(--color-accent, #4a6cf7);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.featured-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.featured-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.featured-source {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.featured-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.8);
}

/* 子标签chip（深色卡片上用亮色描边） */
.subtag-chip {
  font-size: 20rpx;
  color: #a8c0ff;
  background: rgba(74, 108, 247, 0.12);
  border: 1rpx solid rgba(168, 192, 255, 0.5);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

/* 区域chip：绿色描边 */
.subtag-chip-region {
  color: #9ae6b4;
  background: rgba(72, 187, 120, 0.12);
  border-color: rgba(154, 230, 180, 0.5);
}
