// 分类中文标签 + 时间格式化（WXS，供 wxml 直接调用）
var LABELS = {
  company: '公司',
  technology: '技术',
  opensource: '开源',
  funding: '融资',
  opinion: '观点',
  policy: '政策',
  infra: '基建'
};

function categoryLabel(c) {
  return LABELS[c] || c;
}

function pad(n) {
  return n < 10 ? '0' + n : '' + n;
}

// ISO 时间 → 北京时间 'YYYY-MM-DD HH:mm'
function formatTime(iso) {
  if (!iso) return '';
  var d = getDate(iso);
  if (isNaN(d.getTime())) return iso;
  var t = d.getTime() + 8 * 3600 * 1000; // UTC+8
  var b = getDate(t);
  return b.getUTCFullYear() + '-' + pad(b.getUTCMonth() + 1) + '-' + pad(b.getUTCDate())
    + ' ' + pad(b.getUTCHours()) + ':' + pad(b.getUTCMinutes());
}

// ISO 时间 → 相对时间（'x分钟前/x小时前/x天前'，超过30天显示日期）
function relativeTime(iso) {
  if (!iso) return '';
  var d = getDate(iso);
  if (isNaN(d.getTime())) return iso;
  var diff = getDate().getTime() - d.getTime();
  var min = Math.floor(diff / 60000);
  if (min < 1) return '刚刚';
  if (min < 60) return min + '分钟前';
  var hour = Math.floor(min / 60);
  if (hour < 24) return hour + '小时前';
  var day = Math.floor(hour / 24);
  if (day < 30) return day + '天前';
  return formatTime(iso).substring(0, 10);
}

// 分数档位标签：前台不再显示裸分值。
// 裸分值把“模型给的一个相对排序权”假装成精到个位的客观测量，
// 2026-07-30 当天满屏 60-75 分时用户看到的只是一堆无意义的数字。
// 档位与 pipeline/ai-filter.mjs 的 SCORE_BANDS 口径一一对应，改一边必须同步另一边。
function scoreBand(score) {
  // WXS 的 Number 只有常量属性、不能当函数调用（写 Number(x) 会整个 wxml 编译失败，
  // 表现为真机调试连二维码都出不来），故用乘一转数值；非数值得 NaN，被下面的 !s 兜住
  var s = score * 1;
  if (!s) return '';
  if (s >= 90) return '重磅';
  if (s >= 80) return '重要';
  if (s >= 70) return '值得看';
  if (s >= 60) return '可看';
  return '边缘';
}

// 档位对应的样式类（见 app.wxss 的 .score-badge.score-s～d）
function scoreBandClass(score) {
  var s = score * 1; // 同上：WXS 不支持 Number() 调用
  if (!s) return '';
  if (s >= 90) return 'score-s';
  if (s >= 80) return 'score-a';
  if (s >= 70) return 'score-b';
  if (s >= 60) return 'score-c';
  return 'score-d';
}

module.exports = {
  categoryLabel: categoryLabel,
  formatTime: formatTime,
  relativeTime: relativeTime,
  scoreBand: scoreBand,
  scoreBandClass: scoreBandClass
};
